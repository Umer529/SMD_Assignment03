<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seller Account"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="24dp" />

        <!-- Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="2dp" />
        <TextView
            android:id="@+id/tv_seller_name_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seller Name"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:padding="12dp"
            android:background="@color/card_bg"
            android:layout_marginBottom="12dp" />

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="2dp" />
        <TextView
            android:id="@+id/tv_seller_email_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="seller@example.com"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:padding="12dp"
            android:background="@color/card_bg"
            android:layout_marginBottom="12dp" />

        <!-- Phone -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="2dp" />
        <TextView
            android:id="@+id/tv_seller_phone_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone not available"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:padding="12dp"
            android:background="@color/card_bg"
            android:layout_marginBottom="12dp" />

        <!-- Address -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Address"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="2dp" />
        <TextView
            android:id="@+id/tv_seller_address_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Address not available"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:padding="12dp"
            android:background="@color/card_bg"
            android:layout_marginBottom="12dp" />

        <!-- Country -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Country"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="2dp" />
        <TextView
            android:id="@+id/tv_seller_country_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Country not available"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:padding="12dp"
            android:background="@color/card_bg"
            android:layout_marginBottom="24dp" />

    </LinearLayout>

</ScrollView>

